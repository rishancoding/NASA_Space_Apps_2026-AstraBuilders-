# Copy this file to .env in the repository root.
# Obtain the key privately from the project owner. Never commit the real key.
DEEPSEEK_API_KEY=

# Required for chat: create a persistent Upstash Redis database.
# Store all four credentials as server-side secrets in Vercel, never VITE_ variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate privately, e.g. python3 -c 'import secrets; print(secrets.token_hex(32))'
CHAT_LIMIT_SECRET=
CHAT_PER_IP_10_MIN=3
CHAT_DAILY_LIMIT=20
CHAT_LIFETIME_LIMIT=500

# Optional overrides (leave commented to use the app defaults):
# CHAT_PROVIDER=deepseek
# CHAT_MODEL=deepseek-flash
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
