# Keep raw NASA downloads local only; do not commit full archives or media
# The project repo stores only the cleaned and minimal data needed for the app.
data/raw/*
!data/raw/README.md

# Common local artifacts
__pycache__/
*.pyc
.DS_Store
.venv/

# Local credentials; only key-free templates belong in Git.
.env
.env.*
!.env.example
!.env.*.example

# Web app
web/node_modules/
web/dist/
