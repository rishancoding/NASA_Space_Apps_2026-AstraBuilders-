# Keep raw NASA downloads local only; do not commit full archives or media
# The project repo stores only the cleaned and minimal data needed for the app.
data/raw/*
!data/raw/README.md

# Common local artifacts
__pycache__/
*.pyc
.DS_Store
.venv/

# Generated from data/clean/ by firesafe/db.py (rebuilt automatically)
data/firesafe.sqlite
data/.firesafe-*.sqlite

# Local credentials (e.g. DEEPSEEK_API_KEY); only key-free templates belong in Git.
.env
.env.*
!.env.example
!.env.*.example

# Web app
web/node_modules/
web/dist/
/public/
.vercel/
